# =============================================================================
# Inkamoto CRM — copy to .env.local (local) or Vercel → Environment Variables.
# Never commit real secrets. After changing env, restart the server / redeploy.
# =============================================================================

# --- Auth (CRM login) ---
CRM_ACCESS_EMAIL="contact@inkamototours.com"
CRM_ACCESS_PASSWORD="InkamotoCRM2026!"
# CRM_SESSION_SECRET=""

# Optional display
CRM_DEFAULT_OWNER="Team"
# Optional: estimated cost of delivery as 0–1 of closed sales (e.g. 0.45 = 45%). Default 0.
# NEXT_PUBLIC_CRM_COGS_RATE="0.45"

# --- Required: Supabase (CRM data + inbox mail) ---
# https://supabase.com/dashboard → project → Settings → API
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Then run supabase/schema.sql once in the SQL Editor.
# If you ran an older schema, drop CRM tables and re-run this file.

# --- Google Search Console (PAUSED — not required) ---
# Enable later: Search Console API → OAuth client → refresh token
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""
# GSC_SITE_URL="sc-domain:inkamototours.com"

# --- Meta Ads (PAUSED — not required) ---
# META_APP_ID=""
# META_APP_SECRET=""
# META_ACCESS_TOKEN=""
# META_AD_ACCOUNT_ID=""

# --- Brevo (newsletters + invoice email) ---
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="contact@inkamototours.com"
BREVO_SENDER_NAME="Inkamoto Tours"
BREVO_LIST_ID=""

# --- Namecheap Private Email (IMAP inbox sync) ---
IMAP_HOST="mail.privateemail.com"
IMAP_PORT="993"
IMAP_USER="contact@inkamototours.com"
IMAP_PASSWORD=""

# --- Optional: DeepL for inbox message translation (otherwise Google is used) ---
# DEEPL_API_KEY=""

# --- Website forms ---
# No webhook needed: form notifications already arrive at IMAP_USER and are
# pulled in by the Inbox sync.

# --- Optional: turn off auto-adding senders to the newsletter list ---
# NEWSLETTER_AUTO_SUBSCRIBE="false"
